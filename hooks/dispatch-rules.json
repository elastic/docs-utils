{
  "_comment": "Soft skill-dispatch rules for the Elastic Docs Harness. Edit to customize.",
  "prompt_rules": [
    {
      "pattern": "changelog",
      "skill": "fix-changelog",
      "suggestion": "consider using /fix-changelog to improve the changelog entry"
    },
    {
      "pattern": "applies.?to|applies_to",
      "skill": "applies-to-tagging",
      "suggestion": "consider /applies-to-tagging to validate applies_to metadata"
    },
    {
      "pattern": "content.?type|content type",
      "skill": "content-type-checker",
      "suggestion": "consider /content-type-checker to validate content type compliance"
    },
    {
      "pattern": "frontmatter|front.?matter",
      "skill": "frontmatter-audit",
      "suggestion": "consider /frontmatter-audit to check frontmatter completeness"
    },
    {
      "pattern": "jargon|internal.?term",
      "skill": "flag-jargon-skill",
      "suggestion": "consider /flag-jargon-skill to catch internal jargon"
    },
    {
      "pattern": "llm.?matrix|llm performance|model.*benchmark",
      "skill": "llm-matrix-update",
      "suggestion": "consider /llm-matrix-update for LLM benchmark changes"
    },
    {
      "pattern": "redirect|moved|renamed",
      "skill": "docs-redirects",
      "suggestion": "consider /docs-redirects to create the redirect"
    },
    {
      "pattern": "style|vale|grammar|spelling",
      "skill": "docs-check-style",
      "suggestion": "consider /docs-check-style to run Vale style checks"
    }
  ],
  "file_rules": [
    {
      "glob": "*docs-content*/*.md",
      "skill": "docs-check-style",
      "suggestion": "consider /docs-check-style to run Vale style checks on this file"
    },
    {
      "glob": "*changelog*.yaml",
      "skill": "review-changelog",
      "suggestion": "consider /review-changelog to audit this changelog entry"
    },
    {
      "glob": "*changelog*.yml",
      "skill": "review-changelog",
      "suggestion": "consider /review-changelog to audit this changelog entry"
    }
  ]
}
